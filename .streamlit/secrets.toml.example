# .streamlit/secrets.toml.example
# Copy this file to .streamlit/secrets.toml and fill in your values
# Do NOT commit the real secrets.toml to version control

# API Keys
GEMINI_API_KEY = "your_gemini_api_key_here"

# Application Settings
ENVIRONMENT = "production"
DB_PATH = "data/audit_system.db"

# Authentication Settings (streamlit-authenticator)
[credentials]
usernames.admin.email = "admin@example.com"
usernames.admin.name = "Administrator"
usernames.admin.password = "$2b$12$YOUR_HASHED_PASSWORD_HERE"  # Generate using stauth.Hasher

[cookie]
expiry_days = 30
key = "random_signature_key_here"
name = "audit_system_cookie"
